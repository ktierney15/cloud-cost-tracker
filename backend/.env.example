# AWS credentials (or omit and use an AWS profile / instance role).
# The IAM principal needs ce:GetCostAndUsage, ce:GetCostForecast,
# ce:GetDimensionValues and ce:GetTags.
AWS_ACCESS_KEY_ID="your-key-id"
AWS_SECRET_ACCESS_KEY="your-access-key"
AWS_DEFAULT_REGION="us-east-1"

# Cost Explorer charges $0.01 per API request, so responses are cached.
CACHE_TTL_SECONDS=21600

# Email report (only used with `cost-tracker report --email`)
EMAIL_USER="youremail@gmail.com"
EMAIL_PASSWORD="yourpassword"
EMAIL_RECIPIENT="recipient@gmail.com"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
